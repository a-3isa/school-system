DATABASE_URL=postgresql://school:school@localhost:5432/school_dev
JWT_SECRET=change-me
PORT=3000
# Web pages allowed to call the API from a browser, comma-separated (the dashboard and the parent web app).
# Leave empty in development: any page on localhost is allowed. Required in production.
CORS_ORIGINS=
# Set to postgres when more than one API server runs, so live chat reaches phones connected to any of them.
CHAT_ADAPTER=
# Email (sign-up and password codes). Leave empty in development: emails are printed in the log.
SMTP_URL=
EMAIL_FROM=School Platform <no-reply@example.com>
# WhatsApp Cloud API: codes that check a parent's mobile at sign-up. Leave empty in development: codes are printed in the log.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_OTP_TEMPLATE=verify_code
# Push notifications (Firebase Cloud Messaging): the path of the Firebase service account JSON file, or the JSON itself.
# Leave empty in development: nothing is sent, and notifications only show in the app's list. See docs/PUSH.md.
FIREBASE_SERVICE_ACCOUNT=
# MQTT broker for gateways (optional; gateways can also post over HTTP)
MQTT_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
# The broker's login and topic checks (POST /api/gateway/mqtt/auth and /acl) must send this in the x-hook-secret header.
# Without it they work in development and are refused in production.
MQTT_HOOK_SECRET=
