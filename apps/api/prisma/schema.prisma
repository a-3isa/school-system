// School platform — Phase 1 data model (core, timetable, people).
// Every school-owned row carries schoolId; queries are always scoped by it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  ESSENTIALS
  SMART
  COMPLETE
}

enum AttendanceMode {
  MANUAL
  AUTOMATIC
}

enum Role {
  OWNER // platform owner, not tied to a school
  SCHOOL_ADMIN
  TEACHER
  TRANSPORT
  NURSE
  CANTEEN
  ACCOUNTANT
  // Follows up absences and behaviour with the families (أخصائي اجتماعي).
  SOCIAL_WORKER
  PARENT
}

// The stages of Egyptian schooling: two years of KG, six of primary, three of
// preparatory and three of secondary.
enum Stage {
  KG
  PRIMARY
  PREPARATORY
  SECONDARY
  OTHER
}

// The system a class follows: the national curriculum in Arabic or in
// languages, an international one, or Al-Azhar.
enum SchoolSystem {
  NATIONAL_ARABIC
  NATIONAL_LANGUAGES
  BRITISH
  AMERICAN
  IB
  FRENCH
  GERMAN
  AZHAR
  OTHER
}

enum ClassGender {
  MIXED
  BOYS
  GIRLS
}

// The stream a student picks in the later years of secondary (Thanaweya Amma).
enum SecondaryStream {
  SCIENCE
  MATHEMATICS
  LITERARY
}

enum RoomKind {
  CLASSROOM
  LAB
  LIBRARY
  SPORTS
  OTHER
}

enum GuardianRelation {
  MOTHER
  FATHER
  // Another adult responsible for the child (a grandparent, an uncle…), e.g. for an orphan.
  GUARDIAN
}

model School {
  id                String         @id @default(cuid())
  name              String
  nameAr            String?
  // The school's crest, shown in the dashboard and the parent app.
  logo              Bytes?
  logoMime          String?
  timezone          String         @default("Africa/Cairo")
  plan              Plan           @default(ESSENTIALS)
  attendanceMode    AttendanceMode @default(MANUAL)
  // Time (HH:mm, school time zone) when "absent today" notices go to parents.
  absenceNoticeTime String         @default("08:15")
  // Weekdays with lessons, 0 = Sunday … 6 = Saturday.
  schoolDays        Int[]          @default([0, 1, 2, 3, 4])
  createdAt         DateTime       @default(now())

  modules    SchoolModule[]
  years      AcademicYear[]
  holidays   Holiday[]
  studentFiles StudentFile[]
  users      User[]
  grades     Grade[]
  classes    Class[]
  rooms      Room[]
  subjects   Subject[]
  periods    Period[]
  timetable  TimetableEntry[]
  students   Student[]
  auditLogs  AuditLog[]
  attendance AttendanceRecord[]
  excuses    Excuse[]
  classAways ClassAway[]
  notifications Notification[]
  gateways   Gateway[]
  straps     Strap[]
  exceptions AttendanceException[]
  // Detection rules for automatic attendance; see src/devices/rules.ts.
  detection  Json @default("{}")
  // Office hours shown to parents in chat (HH:mm, school time zone); not enforced.
  chatFrom   String @default("08:00")
  chatTo     String @default("15:00")

  announcements  Announcement[]
  polls          Poll[]
  chatThreads    ChatThread[]
  meetingWindows MeetingWindow[]
  behaviourNotes BehaviourNote[]

  assessments  Assessment[]
  reportCards  ReportCard[]
  // Grade bands per school system, overriding the defaults in src/academics/grades.ts.
  // { "BRITISH": [{ "min": 90, "label": "A*", "labelAr": "A*" }, …] }
  gradeBands   Json @default("{}")
  // Shown under the principal's comment on report cards.
  principalName String?
}

model SchoolModule {
  schoolId  String
  key       String
  enabled   Boolean  @default(false)
  // Feature switches inside the module, e.g. { "perPeriod": true }.
  features  Json     @default("{}")
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@id([schoolId, key])
}

model User {
  id           String   @id @default(cuid())
  schoolId     String?
  name         String
  // How staff are addressed: MR, MS, MRS or DR ("Ms. Hana Nabil", «مس هناء نبيل»).
  honorific    String?
  email        String?  @unique
  phone        String?  @unique
  passwordHash String?
  role         Role
  active       Boolean  @default(true)
  // When a parent agreed to their child's presence and location being tracked (decision H39).
  consentAt    DateTime?
  // When the parent proved their mobile with a WhatsApp code in the app.
  phoneVerifiedAt DateTime?
  // When the email was proved by a code sent to it (parents sign up in the app).
  emailVerifiedAt DateTime?
  createdAt    DateTime @default(now())

  school      School?           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  children    StudentGuardian[]
  teaching    TimetableEntry[]
  homerooms   Class[]
  marked      AttendanceRecord[]
  excusesSent Excuse[] @relation("ExcuseSubmitter")
  notifications Notification[]
  deviceTokens DeviceToken[]
  behaviourWritten BehaviourNote[]     @relation("BehaviourAuthor")
  behaviourReads   BehaviourNoteRead[]

  announcementsWritten Announcement[]     @relation("AnnouncementAuthor")
  announcementReads    AnnouncementRead[]
  pollsWritten         Poll[]             @relation("PollAuthor")
  pollTargets          PollTarget[]
  pollVotes            PollVote[]
  chatsAsParent        ChatThread[]       @relation("ChatParent")
  chatsAsStaff         ChatThread[]       @relation("ChatStaff")
  chatSent             ChatMessage[]      @relation("ChatSender")
  meetingWindows       MeetingWindow[]    @relation("MeetingTeacher")
  meetingsBooked       MeetingSlot[]      @relation("MeetingParent")

  @@index([schoolId, role])
}

model Grade {
  id       String @id @default(cuid())
  schoolId String
  name     String
  nameAr   String?
  stage    Stage  @default(OTHER)
  order    Int

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classes Class[]

  @@unique([schoolId, name])
}

model Class {
  id                String  @id @default(cuid())
  schoolId          String
  gradeId           String
  name              String
  // The section within the grade, e.g. 1 in 4/1.
  section           String?
  homeroomTeacherId String?
  system            SchoolSystem?
  gender            ClassGender     @default(MIXED)
  stream            SecondaryStream?
  // How many students the class takes.
  capacity          Int?

  school          School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  grade           Grade            @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  homeroomTeacher User?            @relation(fields: [homeroomTeacherId], references: [id], onDelete: SetNull)
  students        Student[]
  timetable       TimetableEntry[]
  attendance      AttendanceRecord[]
  aways           ClassAway[]
  assessments     Assessment[]
  reportCards     ReportCard[]

  @@unique([schoolId, name])
}

model Room {
  id       String   @id @default(cuid())
  schoolId String
  name     String
  kind     RoomKind @default(CLASSROOM)

  school      School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  timetable   TimetableEntry[]
  gateways    Gateway[]
  assessments Assessment[]

  @@unique([schoolId, name])
}

model Subject {
  id       String  @id @default(cuid())
  schoolId String
  name     String
  // The name in Arabic, shown on Arabic screens and report cards.
  nameAr   String?

  school      School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  timetable   TimetableEntry[]
  assessments Assessment[]

  @@unique([schoolId, name])
}

// The school's bell schedule: period 1 is 08:00–08:45, and so on.
model Period {
  id        String @id @default(cuid())
  schoolId  String
  number    Int
  startTime String // HH:mm
  endTime   String // HH:mm

  school     School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  timetable  TimetableEntry[]
  attendance AttendanceRecord[]

  @@unique([schoolId, number])
}

// One lesson: this class, on this weekday and period, in this room.
model TimetableEntry {
  id        String @id @default(cuid())
  schoolId  String
  classId   String
  dayOfWeek Int // 0 = Sunday … 6 = Saturday
  periodId  String
  roomId    String
  subjectId String
  teacherId String?

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  period  Period  @relation(fields: [periodId], references: [id], onDelete: Cascade)
  room    Room    @relation(fields: [roomId], references: [id], onDelete: Restrict)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  teacher User?   @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@unique([classId, dayOfWeek, periodId])
  @@unique([roomId, dayOfWeek, periodId])
  @@unique([teacherId, dayOfWeek, periodId])
  @@index([schoolId, dayOfWeek])
}

model Student {
  id           String    @id @default(cuid())
  schoolId     String
  code         String
  firstName    String
  lastName     String
  nameAr       String?
  classId      String?
  dateOfBirth  DateTime?
  gender       Gender?
  // ISO 3166 country code, e.g. EG.
  nationality  String?
  // The 14-digit Egyptian national number (on the computerised birth certificate).
  nationalId   String?
  passportNo   String?
  // For religious education classes.
  religion     Religion?
  placeOfBirth String?
  address      String?
  previousSchool String?
  enrolledOn   DateTime? @db.Date
  photoUrl     String?
  bloodType    String?
  allergies    String?
  medicalNotes String?
  // Someone to call when the parents can't be reached.
  emergencyName     String?
  emergencyRelation String?
  emergencyPhone    String?
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())

  school     School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class      Class?             @relation(fields: [classId], references: [id], onDelete: SetNull)
  guardians  StudentGuardian[]
  attendance AttendanceRecord[]
  absenceNotices AbsenceNotice[]
  excuses    Excuse[]
  strap      Strap?
  presence   GatePresence[]
  exceptions AttendanceException[]
  files      StudentFile[]
  chatThreads  ChatThread[]
  meetingSlots MeetingSlot[]
  behaviourNotes BehaviourNote[]
  marks        Mark[]
  reportCards  ReportCard[]

  @@unique([schoolId, code])
  @@unique([schoolId, nationalId])
  @@index([schoolId, classId])
}

// A photo or scan the school keeps for a student: their photo, birth
// certificate, vaccination record… Uploaded first, then attached when the
// student is saved (studentId is empty until then).
model StudentFile {
  id           String   @id @default(cuid())
  schoolId     String
  studentId    String?
  kind         String
  mime         String
  size         Int
  data         Bytes
  uploadedById String?
  createdAt    DateTime @default(now())

  school  School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([schoolId, studentId])
}

// A school year: two terms with a mid-year break between them.
model AcademicYear {
  id            String   @id @default(cuid())
  schoolId      String
  name          String   // e.g. 2026/2027
  startsOn      DateTime @db.Date
  endsOn        DateTime @db.Date
  term2StartsOn DateTime? @db.Date
  breakFrom     DateTime? @db.Date
  breakTo       DateTime? @db.Date

  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assessments Assessment[]
  reportCards ReportCard[]

  @@unique([schoolId, name])
}

// A day or days off: a public holiday, Eid, a school event.
model Holiday {
  id       String   @id @default(cuid())
  schoolId String
  name     String
  fromDate DateTime @db.Date
  toDate   DateTime @db.Date

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, fromDate])
}

enum Gender {
  MALE
  FEMALE
}

enum Religion {
  MUSLIM
  CHRISTIAN
  OTHER
}

// A parent or guardian linked to a child: a mother, a father and one guardian at most.
model StudentGuardian {
  studentId  String
  userId     String
  relation   GuardianRelation
  // Set by the school to limit what this parent sees (e.g. separated families).
  restricted Boolean          @default(false)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([studentId, userId])
  @@unique([studentId, relation])
}

model AuditLog {
  id        String   @id @default(cuid())
  schoolId  String?
  actorId   String?
  action    String
  entity    String
  entityId  String?
  data      Json?
  createdAt DateTime @default(now())

  school School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, createdAt])
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  EXCUSED
  ON_TRIP
}

enum AttendanceSource {
  MANUAL // marked on the classroom PC or the dashboard
  AUTOMATIC // decided from BLE strap sightings
}

// One student's attendance in one period on one day.
model AttendanceRecord {
  id          String           @id @default(cuid())
  schoolId    String
  studentId   String
  classId     String
  periodId    String
  date        DateTime         @db.Date
  status      AttendanceStatus
  source      AttendanceSource
  reason      String?
  markedById  String?
  // Set when an approved excuse turned this absence into an excused one.
  excuseId    String?
  // Automatic mode: when the strap was first seen in the room and for how long.
  firstSeenAt DateTime?
  secondsSeen Int?
  updatedAt   DateTime         @updatedAt

  school   School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student  Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class    Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  period   Period  @relation(fields: [periodId], references: [id], onDelete: Cascade)
  markedBy User?   @relation(fields: [markedById], references: [id], onDelete: SetNull)
  excuse   Excuse? @relation(fields: [excuseId], references: [id], onDelete: SetNull)

  @@unique([studentId, date, periodId])
  @@index([schoolId, date])
  @@index([classId, date])
}

// A class away from its rooms (trip, exam elsewhere), set in advance so
// nobody is flagged absent. Null periods = the whole day.
model ClassAway {
  id          String   @id @default(cuid())
  schoolId    String
  classId     String
  date        DateTime @db.Date
  fromPeriod  Int?
  toPeriod    Int?
  reason      String
  createdById String?
  createdAt   DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class  Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([schoolId, date])
}

// Push notifications to users. Sending is done by the notifications worker;
// the row also serves as the in-app notification list.
model Notification {
  id        String    @id @default(cuid())
  schoolId  String
  userId    String
  type      String
  title     String
  body      String
  data      Json?
  createdAt DateTime  @default(now())
  sentAt    DateTime?
  readAt    DateTime?

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([sentAt])
}

// The "didn't come to school" question for one student on one day. It is sent once
// (the row is the lock), and what the parent answered decides what happens next.
model AbsenceNotice {
  studentId    String
  date         DateTime       @db.Date
  sentAt       DateTime       @default(now())
  // KNOWS: the parent knows where the child is. DOESNT_KNOW: they don't. Null: no answer yet.
  answer       AbsenceAnswer?
  answeredAt   DateTime?
  answeredById String?
  // When the dashboard was told to find the child (answer No, or no answer in time).
  alertedAt    DateTime?

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([studentId, date])
}

enum AbsenceAnswer {
  KNOWS
  DOESNT_KNOW
}

enum ExcuseStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ExcuseReason {
  SICK
  APPOINTMENT
  FAMILY
  OTHER
}

// A parent's excuse for one or more whole school days. The school approves or rejects it.
model Excuse {
  id            String       @id @default(cuid())
  schoolId      String
  studentId     String
  submittedById String
  fromDate      DateTime     @db.Date
  toDate        DateTime     @db.Date
  reason        ExcuseReason
  note          String?
  // An optional photo or PDF (a doctor's note, say).
  fileMime      String?
  fileSize      Int?
  fileData      Bytes?
  status        ExcuseStatus @default(PENDING)
  decidedById   String?
  decidedAt     DateTime?
  decisionNote  String?
  createdAt     DateTime     @default(now())

  school      School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student     Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  submittedBy User               @relation("ExcuseSubmitter", fields: [submittedById], references: [id], onDelete: Cascade)
  records     AttendanceRecord[]

  @@index([schoolId, status])
  @@index([studentId, fromDate])
}

enum GatewayKind {
  GATE
  ROOM
  BUS
  CANTEEN
}

// A BLE gateway (ESP32). Registered by the platform owner with a serial,
// a claim code and a secret; a school claims it with the claim code.
model Gateway {
  id         String       @id @default(cuid())
  serial     String       @unique
  claimCode  String       @unique
  secretHash String
  schoolId   String?
  name       String?
  kind       GatewayKind?
  roomId     String?
  firmware   String?
  lastSeenAt DateTime?
  createdAt  DateTime     @default(now())

  school    School?    @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  room      Room?      @relation(fields: [roomId], references: [id], onDelete: SetNull)
  sightings Sighting[]

  @@index([schoolId])
}

// A student's FSC-BP107D strap, identified by its BLE MAC address.
model Strap {
  id         String    @id @default(cuid())
  schoolId   String
  mac        String
  studentId  String?   @unique
  battery    Int?
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())

  school    School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student   Student?   @relation(fields: [studentId], references: [id], onDelete: SetNull)
  sightings Sighting[]

  @@unique([schoolId, mac])
}

// Raw "gateway heard strap" rows. Kept for one week (decision H38).
model Sighting {
  id        BigInt   @id @default(autoincrement())
  schoolId  String
  gatewayId String
  strapId   String
  rssi      Int
  seenAt    DateTime

  gateway Gateway @relation(fields: [gatewayId], references: [id], onDelete: Cascade)
  strap   Strap   @relation(fields: [strapId], references: [id], onDelete: Cascade)

  @@index([schoolId, seenAt])
  @@index([strapId, seenAt])
}

// Arrival and departure through the school gates, one row per child per day.
model GatePresence {
  studentId String
  date      DateTime  @db.Date
  arrivedAt DateTime?
  lastGateAt DateTime?
  leftAt    DateTime?

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([studentId, date])
}

enum ExceptionType {
  NOT_IN_CLASS // at school (arrived through the gate) but not in the lesson
  LEFT_LESSON // in the lesson for less than the required share
  LEFT_EARLY // went out through the gate during the school day
  STRAP_NOT_SEEN // present by manual mark but the strap wasn't heard
  LOW_BATTERY
  GATEWAY_OFFLINE // a lesson couldn't be decided automatically; mark it manually
  ABSENT_UNKNOWN // the child didn't come and the parents don't know where they are: someone must call
}

enum ExceptionStatus {
  OPEN
  RESOLVED
}

// Things a person has to look at, shown on the dashboard.
model AttendanceException {
  id          String          @id @default(cuid())
  schoolId    String
  type        ExceptionType
  status      ExceptionStatus @default(OPEN)
  date        DateTime        @db.Date
  studentId   String?
  gatewayId   String?
  classId     String?
  periodId    String?
  message     String
  // Stops the same exception being raised twice.
  dedupeKey   String          @unique
  note        String?
  resolvedById String?
  resolvedAt  DateTime?
  createdAt   DateTime        @default(now())

  school  School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([schoolId, date, status])
}

// A phone a parent's app has registered for push notifications (Firebase Cloud Messaging).
model DeviceToken {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  // "android", "ios" or "web".
  platform   String
  // The language the app is shown in, so the push is worded in it.
  lang       String   @default("en")
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Marks a period as already decided from strap sightings.
model EvaluatedPeriod {
  schoolId String
  date     DateTime @db.Date
  periodId String
  at       DateTime @default(now())

  @@id([schoolId, date, periodId])
}

// A one-time sign-in code sent by WhatsApp. Only a hash is stored.
enum CodePurpose {
  SIGNUP // emailed to a parent creating their account (the school registered the email first)
  PHONE // sent by WhatsApp to the mobile a parent gives in the app, at sign-up or when changing it
  RESET // emailed for a forgotten password
}

/** A 6-digit code sent to an email or a mobile, stored hashed. */
model VerificationCode {
  id        String      @id @default(cuid())
  target    String // the email or the mobile number it was sent to
  purpose   CodePurpose
  codeHash  String
  attempts  Int         @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime    @default(now())

  @@index([target, purpose, createdAt])
}

// ---- Messaging ---------------------------------------------------------------

enum AnnouncementPriority {
  NORMAL
  // Sent by Student Affairs to every parent; pinned in the app until acknowledged (decision T7).
  EMERGENCY
}

// A message from the school to the parents of an audience: the whole school, year groups, classes or a club.
model Announcement {
  id         String               @id @default(cuid())
  schoolId   String
  title      String
  body       String
  // { kind: SCHOOL|GRADES|CLASSES|ACTIVITY, ids: string[] }, see src/common/audience.ts
  audience   Json
  priority   AnnouncementPriority @default(NORMAL)
  authorId   String?
  fileData   Bytes?
  fileType   String?
  fileName   String?
  createdAt  DateTime             @default(now())
  // Null while a draft; set when sent.
  sentAt     DateTime?
  // How many parents it reached when it was sent.
  recipients Int                  @default(0)

  school School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  author User?              @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  reads  AnnouncementRead[]

  @@index([schoolId, sentAt])
}

// One row per parent an announcement was sent to.
model AnnouncementRead {
  announcementId String
  userId         String
  readAt         DateTime?
  // Emergency only: the parent pressed "I have read this".
  acknowledgedAt DateTime?

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([announcementId, userId])
  @@index([userId])
}

model Poll {
  id          String    @id @default(cuid())
  schoolId    String
  question    String
  audience    Json
  // Parents may pick more than one option.
  multiple    Boolean   @default(false)
  // Staff see totals only, never who voted for what.
  anonymous   Boolean   @default(true)
  // Parents see the results after voting.
  showResults Boolean   @default(true)
  closesAt    DateTime
  authorId    String?
  createdAt   DateTime  @default(now())
  closedAt    DateTime?

  school  School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  author  User?        @relation("PollAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  options PollOption[]
  votes   PollVote[]
  // The parents it was sent to.
  targets PollTarget[]

  @@index([schoolId, createdAt])
}

model PollOption {
  id     String @id @default(cuid())
  pollId String
  label  String
  order  Int

  poll  Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PollVote[]
}

model PollTarget {
  pollId String
  userId String

  poll Poll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([pollId, userId])
  @@index([userId])
}

model PollVote {
  pollId    String
  optionId  String
  userId    String
  createdAt DateTime @default(now())

  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([pollId, userId, optionId])
}

// A conversation between one parent and one member of staff about one child.
model ChatThread {
  id            String   @id @default(cuid())
  schoolId      String
  studentId     String
  parentId      String
  staffId       String
  createdAt     DateTime @default(now())
  lastMessageAt DateTime @default(now())

  school   School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student  Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent   User          @relation("ChatParent", fields: [parentId], references: [id], onDelete: Cascade)
  staff    User          @relation("ChatStaff", fields: [staffId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@unique([studentId, parentId, staffId])
  @@index([schoolId, staffId, lastMessageAt])
  @@index([parentId, lastMessageAt])
}

model ChatMessage {
  id        String    @id @default(cuid())
  threadId  String
  senderId  String
  body      String
  fileData  Bytes?
  fileType  String?
  fileName  String?
  createdAt DateTime  @default(now())
  // When the other side opened the thread after this message arrived.
  readAt    DateTime?

  thread ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User       @relation("ChatSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

// A teacher's free time for parent meetings on one day, cut into slots.
model MeetingWindow {
  id          String   @id @default(cuid())
  schoolId    String
  teacherId   String
  date        DateTime @db.Date
  fromTime    String // HH:mm
  toTime      String // HH:mm
  slotMinutes Int
  // "Room 204", "Online (link sent the day before)"
  place       String
  createdAt   DateTime @default(now())

  school  School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher User          @relation("MeetingTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  slots   MeetingSlot[]

  @@index([schoolId, date])
  @@index([teacherId, date])
}

model MeetingSlot {
  id         String    @id @default(cuid())
  windowId   String
  startsAt   DateTime
  endsAt     DateTime
  bookedById String?
  studentId  String?
  note       String?
  bookedAt   DateTime?

  window   MeetingWindow @relation(fields: [windowId], references: [id], onDelete: Cascade)
  bookedBy User?         @relation("MeetingParent", fields: [bookedById], references: [id], onDelete: SetNull)
  student  Student?      @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([windowId, startsAt])
  @@index([bookedById])
}

// ---- Behaviour ----------------------------------------------------------------

enum BehaviourKind {
  PRAISE
  CONCERN
  INCIDENT
}

enum IncidentSeverity {
  MINOR
  MODERATE
  SERIOUS
}

// A teacher's or Student Affairs' note about a student: praise, a concern, or an incident.
model BehaviourNote {
  id               String            @id @default(cuid())
  schoolId         String
  studentId        String
  authorId         String?
  kind             BehaviourKind
  // A short tag from the fixed list in src/behaviour/categories.ts, e.g. KINDNESS or HOMEWORK.
  category         String
  text             String
  // Merit points (+ for praise, - for a concern); null when merits are off or for no points.
  points           Int?
  visibleToParents Boolean           @default(true)
  // Incidents only.
  severity         IncidentSeverity?
  actionTaken      String?
  place            String?
  occurredAt       DateTime
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  // Set when the note is withdrawn; withdrawn notes disappear from parents and from the totals.
  withdrawnAt      DateTime?

  school  School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  author  User?               @relation("BehaviourAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  reads   BehaviourNoteRead[]

  @@index([schoolId, occurredAt])
  @@index([studentId, occurredAt])
}

// A parent opened a note.
model BehaviourNoteRead {
  noteId String
  userId String
  readAt DateTime @default(now())

  note BehaviourNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([noteId, userId])
}

enum AssessmentKind {
  CLASSWORK
  QUIZ
  HOMEWORK
  PROJECT
  MIDTERM
  FINAL
}

enum ReportCardStatus {
  DRAFT
  PUBLISHED
}

// Anything that is marked: a quiz, a project, an exam. One class, one subject, one term.
model Assessment {
  id          String         @id @default(cuid())
  schoolId    String
  yearId      String
  term        Int            // 1 or 2, from SchoolCalendar.termOf for `date`
  classId     String
  subjectId   String
  kind        AssessmentKind
  title       String
  date        DateTime       @db.Date
  // Exams only: when and where (HH:mm, school time zone).
  startTime   String?
  endTime     String?
  roomId      String?
  maxScore    Int
  weight      Int            @default(1)
  createdById String?
  createdAt   DateTime       @default(now())
  publishedAt DateTime?

  school  School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  year    AcademicYear @relation(fields: [yearId], references: [id], onDelete: Cascade)
  class   Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject      @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  room    Room?        @relation(fields: [roomId], references: [id], onDelete: SetNull)
  marks   Mark[]

  @@index([schoolId, classId, subjectId, term])
  @@index([schoolId, date])
}

// One student's score on one assessment.
model Mark {
  assessmentId String
  studentId    String
  // Up to 2 decimals; null when absent.
  score        Decimal?  @db.Decimal(6, 2)
  absent       Boolean   @default(false)
  excused      Boolean   @default(false)
  comment      String?
  updatedById  String?
  updatedAt    DateTime  @updatedAt

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([assessmentId, studentId])
  @@index([studentId])
}

// A student's report for one term. Publishing freezes `snapshot`.
model ReportCard {
  id                  String           @id @default(cuid())
  schoolId            String
  studentId           String
  yearId              String
  term                Int
  classId             String
  status              ReportCardStatus @default(DRAFT)
  // { subjectId: "comment" } written by each subject's teacher.
  subjectComments     Json             @default("{}")
  classTeacherComment String?
  principalComment    String?
  // Frozen at publish: see ReportSnapshot in src/academics/grades.ts.
  snapshot            Json?
  publishedAt         DateTime?
  publishedById       String?
  updatedAt           DateTime         @updatedAt

  school  School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  year    AcademicYear @relation(fields: [yearId], references: [id], onDelete: Cascade)
  class   Class        @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([studentId, yearId, term])
  @@index([schoolId, classId, term])
}
