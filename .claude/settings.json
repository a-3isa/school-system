{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm install)",
      "Bash(npm ci)",
      "Bash(npm test *)",
      "Bash(npm run test*)",
      "Bash(npm run build*)",
      "Bash(npm run dev*)",
      "Bash(npm run start:dev*)",
      "Bash(npm run lint*)",
      "Bash(npm run seed*)",
      "Bash(npx tsc *)",
      "Bash(npx jest *)",
      "Bash(npx next build*)",
      "Bash(npx prisma generate*)",
      "Bash(npx prisma migrate dev*)",
      "Bash(npx prisma migrate status*)",
      "Bash(npx prisma migrate deploy*)",
      "Bash(npx prisma format*)",
      "Bash(npx prisma validate*)",
      "Bash(npx ts-node scripts/*)",
      "Bash(flutter analyze*)",
      "Bash(flutter test*)",
      "Bash(flutter pub get*)",
      "Bash(flutter run*)",
      "Bash(flutter build web*)",
      "Bash(dart format*)",
      "Bash(pio run*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git fetch*)",
      "Bash(git switch*)",
      "Bash(git checkout -b *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git restore package-lock.json*)",
      "Bash(git restore apps/parent/pubspec.lock*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(git merge*)",
      "Bash(git rebase*)",
      "Bash(git reset*)",
      "Bash(npx prisma db push*)",
      "Bash(npx prisma db execute*)",
      "Bash(psql *)",
      "Bash(dropdb *)"
    ],
    "deny": [
      "Bash(npx prisma migrate reset*)",
      "Bash(prisma migrate reset*)",
      "Bash(npx prisma db push --force-reset*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Read(**/.env)",
      "Read(**/.env.*.local)",
      "Read(firmware/gateway/include/secrets.h)"
    ]
  }
}
